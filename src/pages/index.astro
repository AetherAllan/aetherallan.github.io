---
import { Image } from "astro:assets"
import BaseLayout from "../layouts/BaseLayout.astro"
import PostList from "../components/PostList.astro"
import PrismHero from "../components/PrismHero.astro"
import PrismRule from "../components/PrismRule.astro"
import avatar from "../assets/avatar.png"
import site from "../data/site.json"
import { getPublishedPosts } from "../lib/posts"

const posts = await getPublishedPosts()
const latest = posts.slice(0, 3)
const [aboutLead, ...aboutRest] = site.about
---

<BaseLayout overlayHeader>
  <PrismHero />

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container section__grid">
      <PrismRule />
      <h2 class="section__label" id="work-title">Selected work</h2>
      <div>
        <ol class="entry-list">
          {
            site.selectedWork.map((work) => (
              <li class="entry">
                <div class="entry__main">
                  <h3 class="entry__title">
                    {work.href ? <a href={work.href}>{work.title}</a> : work.title}
                  </h3>
                  <p class="entry__body">{work.body}</p>
                </div>
                <p class="entry__meta">
                  {work.type}, {work.year}
                </p>
              </li>
            ))
          }
        </ol>
        <a class="section__more" href="https://github.com/AetherAllan">All repositories <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section" id="writing" aria-labelledby="writing-title">
    <div class="container section__grid">
      <h2 class="section__label" id="writing-title">Writing</h2>
      <div>
        <PostList posts={latest} />
        <a class="section__more" href="/blog/">All writing <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section" id="focus" aria-labelledby="focus-title">
    <div class="container section__grid">
      <h2 class="section__label" id="focus-title">Focus</h2>
      <ul class="focus-grid">
        {
          site.focusAreas.map((area) => (
            <li>
              <h3 class="focus-grid__title">{area.title}</h3>
              <p class="focus-grid__body">{area.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="container section__grid">
      <h2 class="section__label" id="about-title">About</h2>
      <div class="about">
        <div class="about__intro">
          <Image class="about__avatar" src={avatar} alt={`${site.name}'s avatar`} width={112} height={112} />
          <p class="about__lead">{aboutLead}</p>
          {aboutRest.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div>
          <h3 class="about__now-title">Lately</h3>
          <ul class="now-list">
            {site.now.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="container section__grid">
      <PrismRule />
      <h2 class="section__label" id="contact-title">Contact</h2>
      <a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </section>
</BaseLayout>
