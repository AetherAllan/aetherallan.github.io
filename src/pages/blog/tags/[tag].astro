---
import BaseLayout from "../../../layouts/BaseLayout.astro"
import PostList from "../../../components/PostList.astro"
import TagFilter from "../../../components/TagFilter.astro"
import { getPublishedPosts, tagSlug, type Post } from "../../../lib/posts"

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  const tags = new Map<string, string>()
  for (const post of posts) {
    for (const tag of post.data.tags) tags.set(tagSlug(tag), tag)
  }
  return [...tags].map(([slug, name]) => ({
    params: { tag: slug },
    props: { name, posts, tagged: posts.filter((post) => post.data.tags.some((t) => tagSlug(t) === slug)) },
  }))
}

interface Props {
  name: string
  posts: Post[]
  tagged: Post[]
}

const { name, posts, tagged } = Astro.props
---

<BaseLayout title={`${name} — Writing`} description={`Writing tagged ${name} by AetherAllan.`}>
  <section class="container page-head">
    <h1 class="page-head__title">{name}</h1>
    <TagFilter posts={posts} current={Astro.params.tag} />
  </section>

  <section class="year-group">
    <div class="container section__grid">
      <h2 class="section__label">Entries</h2>
      <PostList posts={tagged} />
    </div>
  </section>
</BaseLayout>
