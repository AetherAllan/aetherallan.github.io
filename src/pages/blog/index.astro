---
import BaseLayout from "../../layouts/BaseLayout.astro"
import PostList from "../../components/PostList.astro"
import TagFilter from "../../components/TagFilter.astro"
import { getPublishedPosts, postYear, type Post } from "../../lib/posts"

const posts = await getPublishedPosts()

const years = new Map<string, Post[]>()
for (const post of posts) {
  const year = postYear(post)
  years.set(year, [...(years.get(year) ?? []), post])
}
---

<BaseLayout title="Writing" description="Essays, technical notes and CTF write-ups by AetherAllan.">
  <section class="container page-head">
    <h1 class="page-head__title">Writing</h1>
    <p class="page-head__lede">Essays, technical notes and CTF write-ups.</p>
    <TagFilter posts={posts} />
  </section>

  {
    [...years].map(([year, yearPosts]) => (
      <section class="year-group">
        <div class="container section__grid">
          <h2 class="section__label">{year}</h2>
          <PostList posts={yearPosts} dateStyle="short" />
        </div>
      </section>
    ))
  }
</BaseLayout>
