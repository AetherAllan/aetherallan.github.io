---
import { render } from "astro:content"
import BaseLayout from "../../layouts/BaseLayout.astro"
import {
  formatDate,
  getPublishedPosts,
  postHref,
  readingMinutes,
  tagHref,
  type Post,
} from "../../lib/posts"

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }))
}

interface Props {
  post: Post
  newer?: Post
  older?: Post
}

const { post, newer, older } = Astro.props
const { title, description, pubDate, updatedDate, tags, lang } = post.data
const { Content, headings } = await render(post)

const minutes = readingMinutes(post.body ?? "")
const DAY_MS = 86_400_000
const showUpdated = updatedDate && updatedDate.valueOf() - pubDate.valueOf() > DAY_MS

// Some posts use H1 for their sections, others H2: list the top two levels present,
// or only the top level when two levels would make the list too long to scan.
const topDepth = Math.min(...headings.map((heading) => heading.depth))
const twoLevels = headings.filter((heading) => heading.depth <= topDepth + 1)
const topLevel = headings.filter((heading) => heading.depth === topDepth)
const toc = twoLevels.length > 20 && topLevel.length >= 3 ? topLevel : twoLevels
const showToc = toc.length >= 3
---

<BaseLayout title={title} description={description} type="article">
  <article class="container post">
    <div class="post__layout">
      <div class="post__main">
        <header class="post__head">
          <a class="post__back" href="/blog/"><span aria-hidden="true">←</span> Writing</a>
          <h1 class="post__title" lang={lang}>{title}</h1>
          <p class="post__lede" lang={lang}>{description}</p>
          <p class="post__meta">
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            <span>{minutes} min read</span>
            {
              showUpdated && (
                <span>
                  Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, "medium")}</time>
                </span>
              )
            }
            {tags.map((tag) => <a href={tagHref(tag)}>{tag}</a>)}
          </p>
        </header>

        {
          showToc && (
            <details class="toc toc--inline">
              <summary>Contents</summary>
              <ol>
                {toc.map((heading) => (
                  <li class:list={{ toc__sub: heading.depth > topDepth }}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }

        <div class="prose" lang={lang} data-prose>
          <Content />
        </div>

        <nav class="pager" aria-label="More writing">
          {
            older ? (
              <a class="pager__link" href={postHref(older)}>
                <span class="pager__dir">Older</span>
                <span class="pager__title" lang={older.data.lang}>
                  {older.data.title}
                </span>
              </a>
            ) : (
              <span />
            )
          }
          {
            newer && (
              <a class="pager__link pager__link--next" href={postHref(newer)}>
                <span class="pager__dir">Newer</span>
                <span class="pager__title" lang={newer.data.lang}>
                  {newer.data.title}
                </span>
              </a>
            )
          }
        </nav>
      </div>

      {
        showToc && (
          <aside class="toc toc--aside" aria-label="Contents">
            <ol>
              {toc.map((heading) => (
                <li class:list={{ toc__sub: heading.depth > topDepth }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>

<script>
  // Mark the contents entry for the section being read. Headings can be non-Latin,
  // so link hashes are percent-encoded while heading ids are not.
  const sections = [...document.querySelectorAll<HTMLAnchorElement>(".toc--aside a")].flatMap((link) => {
    const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)))
    return heading ? [{ link, heading }] : []
  })
  if (sections.length > 0) {
    let frame = 0
    const update = () => {
      frame = 0
      const passed = sections.filter(({ heading }) => heading.getBoundingClientRect().top <= 120)
      const active = passed.at(-1)
      for (const { link } of sections) {
        if (link === active?.link) link.setAttribute("aria-current", "true")
        else link.removeAttribute("aria-current")
      }
    }
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }
    addEventListener("scroll", schedule, { passive: true })
    addEventListener("resize", schedule)
    update()
  }

  // Copy buttons sit in a wrapper so they don't scroll away with long code lines.
  for (const pre of document.querySelectorAll<HTMLPreElement>("[data-prose] pre")) {
    const wrapper = document.createElement("div")
    wrapper.className = "code-block"
    pre.replaceWith(wrapper)
    wrapper.append(pre)

    const button = document.createElement("button")
    button.type = "button"
    button.className = "code-block__copy"
    button.textContent = "Copy"
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText)
        button.textContent = "Copied"
      } catch {
        button.textContent = "Copy failed"
      }
      setTimeout(() => (button.textContent = "Copy"), 1600)
    })
    wrapper.append(button)
  }
</script>
