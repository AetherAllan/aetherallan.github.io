---
import site from "../data/site.json"

const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>© {year} {site.name}</p>
    <ul class="site-footer__links">
      {
        site.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
