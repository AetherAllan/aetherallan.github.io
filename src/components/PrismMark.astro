---
// The site mark: a white beam enters a prism and leaves as six bands.
interface Props {
  size?: number
  class?: string
}

const { size = 30, class: className } = Astro.props
const bands = ["--s1", "--s2", "--s3", "--s4", "--s5", "--s6"]
---

<svg
  class:list={["prism-mark", className]}
  viewBox="0 0 36 20"
  width={size}
  height={(size * 20) / 36}
  aria-hidden="true"
>
  <line x1="0" y1="14" x2="12.6" y2="10.6" stroke="#f4f4f4" stroke-width="1.1"></line>
  <line x1="12.6" y1="10.6" x2="19.2" y2="9" stroke="#f4f4f4" stroke-opacity="0.45" stroke-width="1"></line>
  {
    bands.map((band, index) => (
      <line
        x1="19.2"
        y1="9"
        x2="36"
        y2={6.4 + index * 1.25}
        style={`stroke: var(${band})`}
        stroke-width="1.1"
      />
    ))
  }
  <path
    d="M16 2.5 L23 15.5 L9 15.5 Z"
    fill="none"
    stroke="currentColor"
    stroke-width="1.1"
    stroke-linejoin="round"></path>
</svg>
