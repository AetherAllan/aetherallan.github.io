---
import site from "../data/site.json"

interface Props {
  /** On the homepage the header floats over the prism instead of taking a row. */
  overlay?: boolean
}

const { overlay = false } = Astro.props
const inBlog = Astro.url.pathname.startsWith("/blog/")
---

<header class:list={["site-header", { "site-header--overlay": overlay }]}>
  <a class="wordmark" href="/">{site.name}</a>
  <nav class="site-nav" aria-label="Primary">
    <a href="/#work">Work</a>
    <a href="/blog/" aria-current={inBlog ? "page" : undefined}>Writing</a>
    <a href="/#about">About</a>
  </nav>
  <a class="header-contact" href={`mailto:${site.email}`}>Get in touch</a>
</header>
