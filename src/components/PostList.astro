---
import { formatDate, postHref, type DateStyle, type Post } from "../lib/posts"

interface Props {
  posts: Post[]
  headingLevel?: "h2" | "h3"
  dateStyle?: DateStyle
}

const { posts, headingLevel: Heading = "h3", dateStyle = "medium" } = Astro.props
---

<ol class="entry-list">
  {
    posts.map((post) => (
      <li class="entry">
        <div class="entry__main">
          <Heading class="entry__title" lang={post.data.lang}>
            <a href={postHref(post)}>{post.data.title}</a>
          </Heading>
          <p class="entry__body" lang={post.data.lang}>
            {post.data.description}
          </p>
        </div>
        <time class="entry__meta" datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate, dateStyle)}
        </time>
      </li>
    ))
  }
</ol>
