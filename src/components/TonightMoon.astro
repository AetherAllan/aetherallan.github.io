---
import { litPath, moonPhase } from "../lib/moon"

// Rendered with the build date, then redrawn on load with the visitor's date.
const phase = moonPhase(new Date())
const RADIUS = 96

// Rough positions of the large maria on the near side, north up.
const maria = [
  { cx: 100, cy: 36, rx: 42, ry: 8 },
  { cx: 72, cy: 64, rx: 26, ry: 20 },
  { cx: 118, cy: 70, rx: 14, ry: 13 },
  { cx: 131, cy: 94, rx: 18, ry: 15 },
  { cx: 166, cy: 80, rx: 10, ry: 12 },
  { cx: 50, cy: 104, rx: 24, ry: 38 },
  { cx: 88, cy: 140, rx: 18, ry: 12 },
  { cx: 151, cy: 120, rx: 11, ry: 16 },
  { cx: 134, cy: 131, rx: 8, ry: 8 },
  { cx: 57, cy: 142, rx: 10, ry: 9 },
]
const craters = [
  { cx: 92, cy: 170, r: 4.5 },
  { cx: 70, cy: 40, r: 3 },
  { cx: 143, cy: 152, r: 3.2 },
  { cx: 38, cy: 78, r: 2.6 },
  { cx: 121, cy: 42, r: 2.2 },
  { cx: 108, cy: 118, r: 2.4 },
]
---

<figure class="tonight" style={`--glow: ${phase.illumination.toFixed(3)}`} data-tonight-root>
  <div class="tonight__halo" aria-hidden="true"></div>
  <svg class="tonight__moon" viewBox="0 0 200 200" aria-hidden="true">
    <defs>
      <radialGradient id="tonight-surface" cx="40%" cy="36%" r="72%">
        <stop offset="0%" style="stop-color: var(--moon-surface-1)"></stop>
        <stop offset="58%" style="stop-color: var(--moon-surface-2)"></stop>
        <stop offset="100%" style="stop-color: var(--moon-surface-3)"></stop>
      </radialGradient>
      <filter id="tonight-terminator" x="-10%" y="-10%" width="120%" height="120%">
        <feGaussianBlur stdDeviation="1.8"></feGaussianBlur>
      </filter>
      <filter id="tonight-maria" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="4"></feGaussianBlur>
      </filter>
      <mask id="tonight-lit" maskUnits="userSpaceOnUse" x="0" y="0" width="200" height="200">
        <path
          d={litPath(phase.fraction, RADIUS, 100)}
          fill="white"
          filter="url(#tonight-terminator)"
          data-tonight-lit
          data-radius={RADIUS}
          data-center="100"></path>
      </mask>
      <clipPath id="tonight-disc">
        <circle cx="100" cy="100" r={RADIUS}></circle>
      </clipPath>
    </defs>

    <circle class="tonight__dark" cx="100" cy="100" r={RADIUS}></circle>
    <g clip-path="url(#tonight-disc)">
      <g mask="url(#tonight-lit)">
        <circle cx="100" cy="100" r={RADIUS} fill="url(#tonight-surface)"></circle>
        <g class="tonight__maria" filter="url(#tonight-maria)">
          {maria.map((m) => <ellipse cx={m.cx} cy={m.cy} rx={m.rx} ry={m.ry} />)}
        </g>
        <g class="tonight__craters">
          {craters.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} />)}
        </g>
      </g>
    </g>
    <circle class="tonight__rim" cx="100" cy="100" r={RADIUS}></circle>
  </svg>

  <figcaption class="tonight__caption">
    <span class="tonight__label">Tonight</span>
    <span class="tonight__name">
      <span data-tonight-text="name">{phase.name}</span>
      <span lang="zh-CN" data-tonight-text="nameZh">{phase.nameZh}</span>
    </span>
    <span class="tonight__stats">
      <span data-tonight-text="illumination">{Math.round(phase.illumination * 100)}% lit</span>
      <span aria-hidden="true">·</span>
      <span data-tonight-text="age">Day {phase.ageDays.toFixed(1)} of 29.5</span>
    </span>
  </figcaption>
</figure>
