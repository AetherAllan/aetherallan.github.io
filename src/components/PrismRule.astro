---
// Section divider: a white line meets a small prism and fans out into the spectrum.
// It draws itself when scrolled into view (see the script in BaseLayout).
---

<div class="prism-rule" aria-hidden="true" data-prism-rule>
  <span class="prism-rule__beam"></span>
  <svg class="prism-rule__prism" viewBox="0 0 20 18">
    <path d="M10 1.2 L18.8 16.8 L1.2 16.8 Z"></path>
  </svg>
  <span class="prism-rule__spectrum"></span>
</div>
