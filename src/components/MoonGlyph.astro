---
import { describePhase, litPath, moonPhase } from "../lib/moon"

interface Props {
  /** Draw the moon as it was on this date. */
  date?: Date
  /** Draw an explicit phase instead (0 new → 0.5 full → 1 new). */
  fraction?: number
  /** Redraw with the visitor's clock on page load (see scripts/tonight.ts). */
  tonight?: boolean
  size?: number
  class?: string
}

const { date, tonight = false, size = 24, class: className } = Astro.props
const phase = moonPhase(date ?? new Date())
const fraction = Astro.props.fraction ?? phase.fraction
// Only dated glyphs carry meaning worth announcing; the rest are decoration.
const label = date && !tonight ? describePhase(phase) : undefined
---

<svg
  class:list={["moon-glyph", className]}
  viewBox="0 0 100 100"
  width={size}
  height={size}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {label && <title>{label}</title>}
  <circle class="moon-glyph__shadow" cx="50" cy="50" r="47" />
  <path
    class="moon-glyph__lit"
    d={litPath(fraction, 47)}
    data-tonight-lit={tonight ? "" : undefined}
    data-radius="47"
  />
</svg>
